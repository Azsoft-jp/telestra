{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": false
  },
  "exclude": [
    "apps/control/**",
    "tests/phase01/**",
    "tests/browser/**",
    "scripts/auth-fixture-child.ts"
  ],
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "nodes/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
