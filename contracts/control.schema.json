{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.example.test/tv/v1/control.schema.json",
  "title": "Phase 01 identity and control contracts",
  "$defs": {
    "PublicJwk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        }
      },
      "required": ["kty", "crv", "x", "kid"]
    },
    "RegisterNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "nodeRole": {
          "enum": ["tuner", "encoder"]
        },
        "publicKey": {
          "$ref": "#/$defs/PublicJwk"
        }
      },
      "required": ["nodeId", "nodeRole", "publicKey"]
    },
    "JoinChallenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        }
      },
      "required": ["nodeId"]
    },
    "JoinNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "proof": {
          "type": "string",
          "minLength": 64,
          "maxLength": 4096
        }
      },
      "required": ["nodeId", "code", "proof"]
    },
    "RotateNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof": {
          "type": "string",
          "minLength": 64,
          "maxLength": 4096
        }
      },
      "required": ["proof"]
    },
    "CredentialResponse": {
      "description": "Node専用の短命資格応答。外側の識別情報と署名済みclaimsの一致も受信側で確認する。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "nodeRole": {
          "enum": ["tuner", "encoder"]
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accessToken": {
          "type": "string",
          "minLength": 64,
          "maxLength": 8192
        }
      },
      "required": [
        "nodeId",
        "nodeRole",
        "credentialVersion",
        "expiresAt",
        "accessToken"
      ]
    },
    "UserClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        }
      },
      "required": ["iss", "aud", "sub", "iat", "exp", "jti"]
    },
    "NodeClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "environment": {
          "enum": ["development", "staging", "production"]
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "nodeRole": {
          "enum": ["tuner", "encoder"]
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "iss",
        "aud",
        "sub",
        "iat",
        "exp",
        "jti",
        "tenantId",
        "environment",
        "nodeId",
        "nodeRole",
        "credentialVersion"
      ]
    },
    "DeviceProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "environment": {
          "enum": ["development", "staging", "production"]
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "purpose": {
          "enum": ["join", "rotate", "connect"]
        },
        "challengeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "iss",
        "aud",
        "sub",
        "iat",
        "exp",
        "jti",
        "tenantId",
        "environment",
        "nodeId",
        "purpose",
        "challengeHash"
      ]
    },
    "ReservationInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reservationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "serviceKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "endsAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["reservationId", "serviceKey", "startsAt", "endsAt"]
    },
    "RecordingState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "state": {
          "enum": ["pending", "recording", "partial", "completed", "failed"]
        },
        "attemptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
          },
          "maxItems": 32
        }
      },
      "required": ["recordingId", "state", "attemptIds"]
    },
    "WsResume": {
      "description": "再接続前の世代を通知する。未確認命令を受領済みとみなす根拠にはしない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastSessionEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["lastSessionEpoch"]
    },
    "WsHello": {
      "description": "接続後の最初の能力登録。実Codec対応の証明には使わない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "nodeRole": {
          "enum": ["tuner", "encoder"]
        },
        "backend": {
          "enum": ["mirakurun", "mirakc", "synthetic", "encoder"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": ["capture", "epg-read", "mock-encode", "encode"]
          },
          "uniqueItems": true,
          "maxItems": 4
        },
        "maxConcurrentJobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "resume": {
          "$ref": "#/$defs/WsResume"
        }
      },
      "required": [
        "agentVersion",
        "nodeRole",
        "backend",
        "capabilities",
        "maxConcurrentJobs"
      ]
    },
    "WsHeartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uptimeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spoolBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["uptimeSeconds", "spoolBytes"],
      "description": "既存payloadの構造を検証する。capture実行とPermit暗号検証は後続Phaseで行う。"
    },
    "WsCaptureStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permit": {
          "$ref": "https://schema.example.test/tv/v1/capture-permit.schema.json"
        }
      },
      "required": ["permit"],
      "description": "既存payloadの構造を検証する。capture実行とPermit暗号検証は後続Phaseで行う。"
    },
    "WsCaptureCancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordingId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "attemptId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": ["recordingId", "attemptId"],
      "description": "既存payloadの構造を検証する。capture実行とPermit暗号検証は後続Phaseで行う。"
    },
    "WsCommandAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "enum": ["accepted", "not implemented", "denied", "expired"]
        }
      },
      "required": ["accepted", "code"],
      "description": "既存payloadの構造を検証する。capture実行とPermit暗号検証は後続Phaseで行う。"
    },
    "WsSessionReady": {
      "description": "署名付きの接続通知。Nodeはこの世代に拘束してhelloを送信する。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heartbeatIntervalSeconds": {
          "const": 15
        },
        "idleTimeoutSeconds": {
          "const": 45
        },
        "resumed": {
          "type": "boolean"
        }
      },
      "required": ["heartbeatIntervalSeconds", "idleTimeoutSeconds", "resumed"]
    },
    "WsReceipt": {
      "description": "制御イベントを受理した通知。録画や変換の実行成功は意味しない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "code": {
          "const": "accepted"
        }
      },
      "required": ["messageId", "code"]
    },
    "WsEnvelope": {
      "description": "制御専用。payloadはtype別Schemaでも検証し、媒体バイトや任意命令を許可しない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "kind": {
          "enum": ["command", "event", "ack"]
        },
        "type": {
          "enum": [
            "session.ready",
            "node.hello",
            "node.heartbeat",
            "capture.start",
            "capture.cancel",
            "command.ack",
            "control.receipt"
          ]
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "sessionEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "payload": {
          "type": "object",
          "maxProperties": 16
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "kind",
        "type",
        "nodeId",
        "sessionEpoch",
        "issuedAt",
        "expiresAt",
        "payload"
      ]
    },
    "ControlClaims": {
      "description": "JWSの署名対象。用途、家庭、環境、資格世代、接続世代、本文を一体で検証する。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "environment": {
          "enum": ["development", "staging", "production"]
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "direction": {
          "enum": ["node-to-control", "control-to-node"]
        },
        "envelope": {
          "$ref": "#/$defs/WsEnvelope"
        }
      },
      "required": [
        "iss",
        "aud",
        "sub",
        "iat",
        "exp",
        "jti",
        "tenantId",
        "environment",
        "nodeId",
        "credentialVersion",
        "direction",
        "envelope"
      ]
    },
    "DispatchCommand": {
      "description": "operator/adminが登録Nodeへ送る限定制御命令。録画割当や実行の成功は意味しない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        },
        "type": {
          "enum": ["capture.start", "capture.cancel"]
        },
        "payload": {
          "type": "object",
          "maxProperties": 8
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["commandId", "type", "payload", "expiresAt"]
    },
    "OidcPublicConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "apiAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authorizationEndpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tokenEndpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "appOrigin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "apiOrigin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "redirectUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "publicJwks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/PublicJwk"
              }
            }
          },
          "required": ["keys"]
        }
      },
      "required": [
        "issuer",
        "clientId",
        "apiAudience",
        "authorizationEndpoint",
        "tokenEndpoint",
        "appOrigin",
        "apiOrigin",
        "redirectUri",
        "publicJwks"
      ],
      "description": "公開clientの固定構成。秘密値や要求から来たURLは含めず、URLの意味条件も検査する。"
    },
    "OidcIdClaims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["iss", "aud", "sub", "iat", "exp", "nonce"],
      "description": "ローカルOIDCのID Token。APIのAccess Tokenとは用途を分け、nonceも照合する。"
    },
    "OidcTokenResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access_token": {
          "type": "string",
          "minLength": 64,
          "maxLength": 8192
        },
        "id_token": {
          "type": "string",
          "minLength": 64,
          "maxLength": 8192
        },
        "token_type": {
          "const": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "scope": {
          "const": "openid telestra.api"
        }
      },
      "required": ["access_token", "id_token", "token_type", "expires_in"],
      "description": "短命資格だけをメモリへ受け付ける。Refresh Tokenや未知項目は拒否する。"
    },
    "OidcCallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["code", "state", "iss"],
      "description": "固定redirect URIへの認可応答。重複クエリとfragmentは解釈前に拒否する。"
    },
    "ApiSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "enum": ["viewer", "recorder", "operator", "admin"]
        },
        "tenantId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "environment": {
          "const": "development"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["subject", "role", "tenantId", "environment", "expiresAt"],
      "description": "APIが現在の所属と失効を確認した利用者情報。Tokenを含めない。"
    },
    "BrowserCallbackMessage": {
      "type": "object",
      "additionalProperties": false,
      "description": "認可結果を同じoriginの元windowへ渡す。URLは固定callbackと開始状態でも検証する。",
      "properties": {
        "type": {
          "const": "telestra.auth.callback.v1"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["type", "url"]
    },
    "BrowserCallbackAck": {
      "type": "object",
      "additionalProperties": false,
      "description": "元windowが照合した認可の完了だけを返す。資格や失敗の詳細は含めない。",
      "properties": {
        "type": {
          "const": "telestra.auth.complete.v1"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "outcome": {
          "enum": ["success", "failed"]
        }
      },
      "required": ["type", "state", "outcome"]
    },
    "CapturePermitV2": {
      "$ref": "https://schema.example.invalid/telestra/v2/capture-permit-v2.schema.json",
      "description": "v2の署名検証専用。WsCaptureStartはv1のまま維持する。"
    },
    "CapturePermitV2Header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "typ", "kid"],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "typ": {
          "const": "telestra-capture-permit-v2+jwt"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        }
      },
      "description": "録画許可専用の固定header。鍵URL、埋込鍵、crit、b64等の拡張を拒否する。"
    },
    "CapturePermitV2Key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kty", "crv", "x", "kid"],
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{3,128}$"
        }
      },
      "description": "用途別に構成する公開鍵。秘密鍵、未知項目、他のalgを拒否する。"
    },
    "CapturePermitV2Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "environment",
        "nodeId",
        "nodeRole",
        "authorizationEpoch",
        "assignmentEpoch",
        "reservationId",
        "reservationRevision",
        "recordingId",
        "attemptId",
        "backendId",
        "serviceKey",
        "captureScope",
        "storageScopeId",
        "now",
        "maxObservedTime",
        "maxPermitLifetime",
        "maxOfflineSeconds",
        "captureEarliest",
        "captureLatest",
        "maxSpoolBytes",
        "anchorKnown",
        "revoked"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "environment": {
          "enum": ["development", "staging", "production"],
          "description": "対象環境。この契約はデプロイを許可するものではない。"
        },
        "nodeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "nodeRole": {
          "const": "tuner",
          "description": "Tuner役専用。EncodeNodeの資格として使わない。"
        },
        "authorizationEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "失効・再認可の世代。通常のCredential更新とは分ける。"
        },
        "assignmentEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "割当と許可内容の世代。許可更新で進め、同じ実行中attemptと物理再試行を区別する。"
        },
        "reservationId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "reservationRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "この許可を作った予約の版。"
        },
        "recordingId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "attemptId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "backendId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "serviceKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "captureScope": {
          "enum": ["service-filtered", "multiplex"],
          "description": "必須の保存範囲。multiplexへの暗黙の拡大を許可しない。"
        },
        "storageScopeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "now": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxObservedTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPermitLifetime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOfflineSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "captureEarliest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "captureLatest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxSpoolBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "anchorKnown": {
          "const": true,
          "description": "検証済みpolicyと時計の確認情報がある場合だけtrueとする。"
        },
        "revoked": {
          "const": false,
          "description": "既知の失効がある場合は拒否する。"
        }
      },
      "description": "呼出元が確認済みのpolicy・時計。受信Permitから期待値を補ってはならない。署名付きpolicyの取得・永続化は別途必要。"
    }
  }
}
