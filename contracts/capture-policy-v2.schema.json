{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.example.invalid/telestra/v2/capture-policy-v2.schema.json",
  "title": "Capture Policy v2の署名対象",
  "description": "D1の確定した割当と現在のNode・予約に拘束する。構造・署名だけで媒体実行やStorage書込を許可しない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "iss",
    "sub",
    "jti",
    "iat",
    "exp",
    "tenantId",
    "environment",
    "nodeId",
    "nodeRole",
    "authorizationEpoch",
    "assignmentEpoch",
    "reservationId",
    "reservationRevision",
    "recordingId",
    "attemptId",
    "backendId",
    "serviceKey",
    "captureScope",
    "storageScopeId",
    "aud",
    "permitId",
    "maxPermitLifetime",
    "maxOfflineSeconds",
    "captureEarliest",
    "captureLatest",
    "maxSpoolBytes",
    "revoked"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "description": "v2専用。現行v1の制御命令とは交換しない。"
    },
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "HTTPS発行者との完全一致を検証器で確認する。汎用URI形式の同値性に依存せず、URLから鍵を取得しない。"
    },
    "sub": {
      "$ref": "#/$defs/id",
      "description": "対象Node。nodeIdと信頼済みpolicyの両方へ一致させる。"
    },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "不変のPolicy ID。Permit IDと配送IDを別に扱う。"
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "発行時刻。NumericDateの整数秒。"
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "録画を継続できる期限。NumericDateの整数秒。"
    },
    "tenantId": {
      "$ref": "#/$defs/id",
      "description": "対象家庭。Nodeの信頼済み構成と照合する。"
    },
    "environment": {
      "enum": ["development", "staging", "production"],
      "description": "対象環境。この契約はデプロイを許可するものではない。"
    },
    "nodeId": {
      "$ref": "#/$defs/id",
      "description": "対象Node。subと登録主体の両方へ一致させる。"
    },
    "nodeRole": {
      "const": "tuner",
      "description": "Tuner役専用。EncodeNodeの資格として使わない。"
    },
    "authorizationEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "失効・再認可の世代。通常のCredential更新とは分ける。"
    },
    "assignmentEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "割当と許可内容の世代。許可更新で進め、同じ実行中attemptと物理再試行を区別する。"
    },
    "reservationId": {
      "$ref": "#/$defs/id",
      "description": "予約intentの識別子。"
    },
    "reservationRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "この許可を作った予約の版。"
    },
    "recordingId": {
      "$ref": "#/$defs/id",
      "description": "論理録画の識別子。"
    },
    "attemptId": {
      "$ref": "#/$defs/id",
      "description": "不変の録画試行。別Nodeへ再割当すると別IDにする。"
    },
    "backendId": {
      "$ref": "#/$defs/id",
      "description": "事前構成済みBackendの識別子。URLではない。"
    },
    "serviceKey": {
      "$ref": "#/$defs/id",
      "description": "録画対象サービスの識別子。Backendとの対応は別途検証する。"
    },
    "captureScope": {
      "enum": ["service-filtered", "multiplex"],
      "description": "必須の保存範囲。multiplexへの暗黙の拡大を許可しない。"
    },
    "storageScopeId": {
      "$ref": "#/$defs/id",
      "description": "原本書込の論理権限。短命Upload Grantの本文やURLではない。"
    },
    "aud": {
      "const": "telestra-tuner-capture-policy",
      "description": "録画policy専用。Permit・Node接続・利用者資格へ転用しない。"
    },
    "permitId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "このpolicyが拘束する不変Permit ID。別のPermitへ転用しない。"
    },
    "maxPermitLifetime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxOfflineSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "captureEarliest": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "captureLatest": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxSpoolBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revoked": {
      "type": "boolean",
      "description": "明示した割当失効。資格の期限やHTTP失敗から推測しない。"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
