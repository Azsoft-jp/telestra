{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.example.test/tv/v1/mock-capture.schema.json",
  "title": "Go Mock Tuner output; no playable broadcast media",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixtureId": {
      "const": "synthetic-ts-v1"
    },
    "backend": {
      "enum": ["mirakurun-mock", "mirakc-mock"]
    },
    "packetSize": {
      "enum": [188, 204]
    },
    "sourceBase64": {
      "type": "string",
      "maxLength": 1400000
    },
    "sourceStreamSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chunks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dataBase64": {
            "type": "string",
            "maxLength": 1400000
          }
        },
        "required": ["sequence", "sizeBytes", "sha256", "dataBase64"]
      },
      "maxItems": 64
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "startAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "name", "startAt", "duration"]
      },
      "maxItems": 16
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": ["id", "name"]
      },
      "maxItems": 16
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "GR"
          },
          "channel": {
            "type": "string",
            "maxLength": 16
          }
        },
        "required": ["type", "channel"]
      },
      "maxItems": 16
    }
  },
  "required": [
    "fixtureId",
    "backend",
    "packetSize",
    "sourceBase64",
    "sourceStreamSha256",
    "chunks",
    "programs",
    "services",
    "channels"
  ]
}
