{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.example.test/tv/v1/capture-permit.schema.json",
  "title": "Signed Capture Permit v1",
  "description": "Structure only. Cryptographic canonicalization, signature verification, revocation, key rotation and offline reservation semantics require separate implementation and security review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keyId", "algorithm", "claims", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "keyId": { "type": "string", "minLength": 4, "maxLength": 128 },
    "algorithm": { "const": "Ed25519" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitId", "nodeId", "recordingId", "attemptId", "serviceKey", "issuedAt", "notBefore", "notAfter", "offlineAllowedUntil", "spoolMaxBytes", "storageGrantRef"],
      "properties": {
        "permitId": { "type": "string", "minLength": 8 },
        "nodeId": { "type": "string", "minLength": 4 },
        "recordingId": { "type": "string", "minLength": 4 },
        "attemptId": { "type": "string", "minLength": 4 },
        "serviceKey": { "type": "string", "minLength": 4 },
        "captureScope": { "enum": ["service-filtered", "multiplex"] },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" },
        "offlineAllowedUntil": { "type": "string", "format": "date-time" },
        "spoolMaxBytes": { "type": "integer", "minimum": 0 },
        "storageGrantRef": { "type": "string", "minLength": 4, "maxLength": 128 }
      }
    },
    "signature": { "type": "string", "minLength": 64, "maxLength": 512 }
  }
}
